#!/usr/bin/env bash
# Refuses commits on main or from the main checkout, then runs npm run check.
# VERSION is no longer stamped here: server.js stamps it on serve and pages.yml at deploy
# (ADR 0003), so no two PRs edit the same line.
set -euo pipefail

# Every session works in its own worktree on its own branch (CLAUDE.md, "Working directory").
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "pre-commit: refusing a commit on main. Branch in a worktree and open a PR." >&2
  exit 1
fi
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ]; then
  echo "pre-commit: refusing a commit from the main checkout; it stays on main." >&2
  echo "  git worktree add ../wt/$branch $branch   # then commit from there" >&2
  exit 1
fi

# Syntax, manifest and lint check. A failure here aborts the commit.
# ponytail: checks the working tree, not just what is staged; a partial stage can pass on unstaged fixes.
npm run -s check
